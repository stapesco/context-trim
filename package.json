{
  "name": "stapes-context-trim",
  "version": "0.1.0",
  "description": "Strip a codebase to the essentials for an AI prompt. Respects .gitignore. Skips node_modules, lockfiles, binaries, build output. One command, no install, no cloud, no API key. Stable --json summary for AI agents.",
  "type": "module",
  "bin": {
    "stapes-context-trim": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "claude",
    "gpt",
    "context-window",
    "codebase",
    "prompt",
    "markdown-digest",
    "repomix",
    "code2prompt",
    "gitingest",
    "ai-agent",
    "cli",
    "npx",
    "zero-config",
    "gitignore",
    "stapes"
  ],
  "license": "MIT",
  "author": "stapesco <github@stapes.co.za>",
  "homepage": "https://github.com/stapesco/context-trim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stapesco/context-trim.git"
  },
  "bugs": {
    "url": "https://github.com/stapesco/context-trim"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "ignore": "^5.3.0"
  }
}