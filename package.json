{
  "name": "stapes-context-trim",
  "version": "0.1.0",
  "description": "Strip a codebase down to the essentials for an AI prompt. Respects .gitignore. Zero config. Zero cloud.",
  "type": "module",
  "bin": {
    "stapes-context-trim": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "context",
    "codebase",
    "prompt",
    "repomix",
    "code2prompt",
    "stapes"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "ignore": "^5.3.0"
  }
}